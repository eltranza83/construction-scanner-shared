rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    match /admins/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if false;
    }

    match /user_access/{uid} {
      allow get: if signedIn() && (isAdmin() || request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'sourceInviteId', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.sourceInviteId)).data.claimedByUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /invites/CONFIG-GEMINI {
      allow read, write: if false;
    }

    match /invites/{code} {
      allow get: if signedIn()
        && code != 'CONFIG-GEMINI'
        && (
          isAdmin()
          || resource.data.used == false
          || resource.data.claimedByUid == request.auth.uid
        );
      allow list: if isAdmin()
        || (
          signedIn()
          && code != 'CONFIG-GEMINI'
          && resource.data.claimedByUid == request.auth.uid
        );
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && code != 'CONFIG-GEMINI'
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.claimedByUid == request.auth.uid
          && request.resource.data.claimedByEmail == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'used',
            'usedAt',
            'claimedByUid',
            'claimedByEmail'
          ])
        );
    }

    match /memories/{memoryId} {
      allow get: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid) && request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }
  }
}

